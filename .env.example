# Copy to .env and fill in real values. Never commit .env.

# --- Tesla Fleet API ---
TESLA_ACCESS_TOKEN=your_token_here
TESLA_REFRESH_TOKEN=
TESLA_VIN=your_vin_here
TESLA_REGION=na
# Optional full override for READS (vehicle list / vehicle_data)
# TESLA_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com

# Signed command proxy (tesla-http-proxy). Required for lock/climate/charge/flash.
TESLA_COMMAND_BASE_URL=https://127.0.0.1:4443
TESLA_COMMAND_HTTP_VERIFY=false

DEMO_MODE=false

HOME_ELECTRICITY_RATE=650
SUPERCHARGER_RATE=1300
BATTERY_CAPACITY_KWH=75

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=tesla-familia-verify
WHATSAPP_RECIPIENTS=+57YOUR_NUMBER

TRIP_POLL_SECONDS=45
CHARGE_LOW_PERCENT=20
CHARGE_REMINDER_TARGET=80
CHARGE_REMINDER_COOLDOWN_MIN=60
