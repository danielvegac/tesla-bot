# Copy to .env and fill in real values. Never commit .env.

# --- Tesla Fleet API ---
# Use developer app 523a361f-12e3-4f22-a95e-b71348948b51 (owner mccepedap).
# Do NOT use app 8176c514 — danielvegac.github.io is already bound to 523.
TESLA_ACCESS_TOKEN=your_token_here
TESLA_REFRESH_TOKEN=
TESLA_VIN=LRWYGCFJ0TC568877
TESLA_REGION=na
# Optional full override for READS (vehicle list / vehicle_data)
# TESLA_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com

# Signed command proxy (tesla-http-proxy). Required for lock/climate/charge/flash.
TESLA_COMMAND_BASE_URL=https://127.0.0.1:4443
TESLA_COMMAND_HTTP_VERIFY=false

DEMO_MODE=false

HOME_ELECTRICITY_RATE=650
SUPERCHARGER_RATE=1300
BATTERY_CAPACITY_KWH=75

# --- Telegram (official Bot API) ---
# 1. iPhone → @BotFather → /newbot → paste token here (see docs/TELEGRAM_SETUP.md)
# 2. Run: python3 main.py --telegram --setup
# 3. Write "hola" to the bot → it replies with your chat id
# 4. Put that number here (comma-separated for family), restart without --setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=tesla-familia-verify
WHATSAPP_RECIPIENTS=+57YOUR_NUMBER

TRIP_POLL_SECONDS=45
CHARGE_LOW_PERCENT=20
CHARGE_REMINDER_TARGET=80
CHARGE_REMINDER_COOLDOWN_MIN=60
